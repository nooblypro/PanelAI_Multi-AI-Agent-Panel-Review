# LLM Provider: "openrouter" or "gemini"
LLM_PROVIDER=openrouter

# OpenRouter Configuration
OPENROUTER_API_KEY=
# Fast production model options:
# - google/gemini-2.0-flash-001 (Recommended for sub-second latency)
# - meta-llama/llama-3.3-70b-instruct
# - nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free (Free tier fallback)
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Gemini Configuration (alternative provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# CORS Allowed Origins (comma-separated list or JSON array)
# Local:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example:
# CORS_ORIGINS=https://promptwars.onrender.com,https://promptwars.vercel.app
